{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "780px",
			"wideSize": "1120px"
		},
		"color": {
			"palette": [
				{
					"name": "Primary",
					"slug": "primary",
					"color": "#176b5c"
				},
				{
					"name": "Accent",
					"slug": "accent",
					"color": "#b45309"
				},
				{
					"name": "Text",
					"slug": "text",
					"color": "#1f2933"
				},
				{
					"name": "Surface",
					"slug": "surface",
					"color": "#f7f7f5"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "System Sans",
					"slug": "system-sans",
					"fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "#ffffff",
			"text": "#1f2933"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system-sans)",
			"lineHeight": "1.7"
		}
	}
}
