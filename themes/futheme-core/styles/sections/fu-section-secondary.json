{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"title": "輔色區段 Secondary",
	"slug": "fu-section-secondary",
	"blockTypes": [
		"core/group",
		"core/columns"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|secondary",
			"text": "var:preset|color|primary-contrast"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|primary-contrast"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|base",
					"text": "var:preset|color|primary"
				}
			}
		}
	}
}
