{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": true,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [],
			"gradients": [],
			"palette": [
				{
					"color": "#1769AA",
					"name": "Primary",
					"slug": "primary"
				},
				{
					"color": "#FFFFFF",
					"name": "Primary Contrast",
					"slug": "primary-contrast"
				},
				{
					"color": "#174A70",
					"name": "Secondary",
					"slug": "secondary"
				},
				{
					"color": "#8A4B08",
					"name": "Accent",
					"slug": "accent"
				},
				{
					"color": "#FFFFFF",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#F0F6FC",
					"name": "Surface",
					"slug": "surface"
				},
				{
					"color": "#17212B",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#52606D",
					"name": "Muted",
					"slug": "muted"
				},
				{
					"color": "#778391",
					"name": "Border",
					"slug": "border"
				},
				{
					"color": "#17212B",
					"name": "Focus",
					"slug": "focus"
				},
				{
					"color": "#21633B",
					"name": "Success",
					"slug": "success"
				},
				{
					"color": "#805900",
					"name": "Warning",
					"slug": "warning"
				},
				{
					"color": "#A52834",
					"name": "Danger",
					"slug": "danger"
				}
			]
		},
		"layout": {
			"contentSize": "48rem",
			"wideSize": "75rem"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "2XS",
					"size": "0.25rem",
					"slug": "10"
				},
				{
					"name": "XS",
					"size": "0.5rem",
					"slug": "20"
				},
				{
					"name": "S",
					"size": "0.75rem",
					"slug": "30"
				},
				{
					"name": "M",
					"size": "1rem",
					"slug": "40"
				},
				{
					"name": "L",
					"size": "1.5rem",
					"slug": "50"
				},
				{
					"name": "XL",
					"size": "2rem",
					"slug": "60"
				},
				{
					"name": "2XL",
					"size": "3rem",
					"slug": "70"
				},
				{
					"name": "3XL",
					"size": "4rem",
					"slug": "80"
				}
			],
			"units": [
				"px",
				"rem",
				"%",
				"vw",
				"vh"
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": false,
			"fontFamilies": [
				{
					"name": "System",
					"slug": "system",
					"fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif"
				}
			],
			"fontSizes": [
				{
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"name": "Medium",
					"size": "1rem",
					"slug": "medium"
				},
				{
					"name": "Large",
					"size": "1.25rem",
					"slug": "large"
				},
				{
					"name": "Extra Large",
					"size": "1.75rem",
					"slug": "x-large"
				},
				{
					"name": "Huge",
					"size": "2.25rem",
					"slug": "xx-large"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|50",
			"padding": {
				"top": "0",
				"right": "var:preset|spacing|40",
				"bottom": "0",
				"left": "var:preset|spacing|40"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|system",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.65"
		},
		"css": ":where(a,button,input,select,textarea,summary,[tabindex]):focus-visible{outline:2px solid var(--wp--preset--color--focus);outline-offset:2px;box-shadow:0 0 0 2px var(--wp--preset--color--base)}.wp-site-blocks>*+*{margin-block-start:0}.fu-banner:not(:has(>.wp-block-cover__image-background))>.wp-block-cover__background{background-color:var(--wp--preset--color--primary)!important;opacity:1!important}.fu-card{height:100%;overflow:hidden}.fu-card .wp-block-post-featured-image{margin:0;width:100%}.fu-card:not(:has(.wp-block-post-featured-image))::before{content:\"\";display:block;width:100%;aspect-ratio:16/9;background:color-mix(in srgb,var(--wp--preset--color--primary) 16%,var(--wp--preset--color--surface))}.wp-block-search__inside-wrapper{max-width:100%}.fu-banner :focus-visible,.fu-site-footer :focus-visible{outline-color:var(--wp--preset--color--primary-contrast);box-shadow:0 0 0 2px var(--wp--preset--color--focus)}.fu-banner--default>.wp-block-cover__background{background-color:var(--wp--preset--color--primary)!important;opacity:.8!important}.fu-site-footer__bottom{border-top:1px solid color-mix(in srgb,var(--wp--preset--color--primary-contrast) 30%,transparent)}",
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|primary"
				},
				"typography": {
					"textDecoration": "underline"
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.25"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|large"
				}
			},
			"button": {
				"border": {
					"radius": "0.375rem"
				},
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|primary-contrast"
				},
				"spacing": {
					"padding": {
						"top": "0.625rem",
						"right": "var:preset|spacing|50",
						"bottom": "0.625rem",
						"left": "var:preset|spacing|50"
					}
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|primary",
						"text": "var:preset|color|primary-contrast"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus-visible": {
					"color": {
						"background": "var:preset|color|primary",
						"text": "var:preset|color|primary-contrast"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|medium"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/post-date": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|border"
				},
				"border": {
					"width": "1px 0 0 0"
				}
			},
			"core/site-title": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "700"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/query-pagination": {
				"typography": {
					"fontSize": "var:preset|font-size|medium"
				}
			},
			"core/query-title": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"core/post-excerpt": {
				"typography": {
					"lineHeight": "1.65"
				}
			},
			"core/site-tagline": {
				"typography": {
					"fontSize": "var:preset|font-size|medium"
				}
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	]
}
