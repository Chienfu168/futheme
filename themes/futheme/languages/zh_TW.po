msgctxt "Pattern title"
msgid "Contact section"
msgstr "聯絡區塊"

msgctxt "Pattern description"
msgid "Primary-colour call to action with contact details and a button. Replace the sample details with your own; the theme does not include a form or store any data."
msgstr "主色底的聯絡區塊，含聯絡方式與按鈕。請換成自己的聯絡資料；佈景不含表單，也不儲存任何資料。"

msgid "Get in touch"
msgstr "與我們聯絡"

msgid "Tell visitors how to reach you and when to expect a reply."
msgstr "告訴訪客怎麼聯絡你，以及多久會回覆。"

msgid "Phone"
msgstr "電話"

msgid "Add your phone number"
msgstr "填入電話號碼"

msgid "Email"
msgstr "電子郵件"

msgid "Add your email address"
msgstr "填入電子郵件"

msgid "Address"
msgstr "地址"

msgid "Add your address or office hours"
msgstr "填入地址或服務時間"

msgid "Contact us"
msgstr "聯絡我們"

msgctxt "Pattern title"
msgid "Comments"
msgstr "留言"

msgctxt "Pattern description"
msgid "Comment list and native comment form. No avatars, so no external image requests."
msgstr "留言列表與原生留言表單。不顯示大頭貼，不向外部載入圖片。"

msgid "Comments"
msgstr "留言"

msgctxt "Pattern title"
msgid "Service cards"
msgstr "服務卡片"

msgctxt "Pattern description"
msgid "Section heading with three service cards in a responsive grid. Replace the sample text with your own services."
msgstr "區塊標題加三張服務卡片，自動依螢幕寬度換欄。請把範例文字換成自己的服務。"

msgid "Our services"
msgstr "我們的服務"

msgid "A short sentence that explains what you offer and who it is for."
msgstr "用一句話說明你提供什麼服務、服務哪些人。"

msgid "First service"
msgstr "第一項服務"

msgid "Describe the first service in one or two sentences."
msgstr "用一兩句話說明第一項服務。"

msgid "Second service"
msgstr "第二項服務"

msgid "Describe the second service in one or two sentences."
msgstr "用一兩句話說明第二項服務。"

msgid "Third service"
msgstr "第三項服務"

msgid "Describe the third service in one or two sentences."
msgstr "用一兩句話說明第三項服務。"
